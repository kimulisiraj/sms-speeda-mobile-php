{
    "name": "kimulisiraj/sms-speeda-mobile-php",
    "description": "Send SMS using speed mobile api",
    "keywords": [
        "kimulisiraj",
        "sms-speeda-mobile-php",
        "sms",
        "sms-client"
    ],
    "homepage": "https://github.com/kimulisiraj/sms-speeda-mobile-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Siraj Kimuli",
            "email": "pworld.designer@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "pestphp/pest": "^3.8 || ^4.0",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Kimulisiraj\\SmsSpeedaMobile\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kimulisiraj\\SmsSpeedaMobile\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes",
        "format-check": "vendor/bin/php-cs-fixer fix --allow-risky=yes --dry-run --diff",
        "refactor": "vendor/bin/rector process",
        "refactor-check": "vendor/bin/rector process --dry-run"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
